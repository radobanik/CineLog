<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CineLog.Mobile</RootNamespace>
    <ApplicationTitle>CineLog</ApplicationTitle>
    <ApplicationId>com.cinelog.mobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CineLog.Mobile.Core\CineLog.Mobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0-rc.2.25504.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="123.1.2" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <GoogleServicesJson Include="Platforms\Android\google-services.json" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#00CC44" ForegroundScale="0.6" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D0D0D" BaseSize="256,256" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" />
    <MauiRawAsset Include="Resources\Raw\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Controls\Skeletons\ActivityLogEventItemSkeleton.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\MainPages\WatchListPage.xaml.cs">
      <DependentUpon>WatchListPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="View\Search\UserSearchRowView.xaml.cs">
      <DependentUpon>UserSearchRowView.xaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\Skeletons\ActivityLogEventItemSkeleton.xaml.cs">
      <DependentUpon>ActivityLogEventItemSkeleton.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Controls\FollowToggleButton.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Pages\Movies\MovieWatchListPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="View\Search\MovieSearchTabView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="View\Search\PeopleSearchTabView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="View\WatchList\WatchListNameFormView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="View\WatchList\WatchListRowView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

</Project>
