<ContentView
    x:Class="CineLog.Mobile.Controls.FollowToggleButtonView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Button
        Command="{Binding Source={x:Reference Root}, Path=Command}"
        CommandParameter="{Binding Source={x:Reference Root}, Path=CommandParameter}"
        Style="{StaticResource FollowToggleButton}"
        Text="{Binding Source={x:Reference Root}, Path=Text}">
        <Button.Triggers>
            <DataTrigger
                Binding="{Binding Source={x:Reference Root}, Path=IsFollowing}"
                TargetType="Button"
                Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}" />
                <Setter Property="TextColor" Value="{StaticResource Error}" />
                <Setter Property="BorderColor" Value="{StaticResource SurfaceVariant}" />
                <Setter Property="BorderWidth" Value="0" />
            </DataTrigger>
        </Button.Triggers>
    </Button>
</ContentView>
