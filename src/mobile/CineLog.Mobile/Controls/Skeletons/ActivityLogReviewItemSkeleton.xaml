<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Controls.ActivityLogReviewItemSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto">
        <VerticalStackLayout Padding="0,16" Spacing="10">

            <Grid ColumnDefinitions="34,*,58" ColumnSpacing="10">

                <controls:SkeletonView
                    Grid.Column="0"
                    HeightRequest="28"
                    WidthRequest="28"
                    CornerRadius="14"
                    VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <controls:SkeletonView HeightRequest="13" HorizontalOptions="Fill" CornerRadius="6" />
                    <controls:SkeletonView HeightRequest="13" WidthRequest="160" HorizontalOptions="Start" CornerRadius="6" />
                </VerticalStackLayout>

                <controls:SkeletonView
                    Grid.Column="2"
                    HeightRequest="76"
                    WidthRequest="54"
                    CornerRadius="5"
                    VerticalOptions="Center" />

            </Grid>

            <Border
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <VerticalStackLayout Padding="10" Spacing="4">
                    <controls:SkeletonView HeightRequest="11" WidthRequest="50" HorizontalOptions="Start" CornerRadius="5" />
                    <controls:SkeletonView HeightRequest="10" HorizontalOptions="Fill" CornerRadius="5" />
                    <controls:SkeletonView HeightRequest="10" WidthRequest="200" HorizontalOptions="Start" CornerRadius="5" />
                </VerticalStackLayout>
            </Border>

            <controls:SkeletonView HeightRequest="12" WidthRequest="72" HorizontalOptions="Start" CornerRadius="6" />

        </VerticalStackLayout>

        <BoxView Grid.Row="1" Style="{StaticResource ListDivider}" />
    </Grid>
</ContentView>
