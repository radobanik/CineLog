<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Controls.MovieDetailSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout Spacing="0">

        <!-- Backdrop -->
        <controls:SkeletonView HeightRequest="220" CornerRadius="0" />

        <!-- Poster + Title row -->
        <Grid ColumnDefinitions="Auto, *" Padding="16,0,16,12">
            <controls:SkeletonView
                Grid.Column="0"
                WidthRequest="90"
                HeightRequest="130"
                CornerRadius="10"
                Margin="0,-50,14,0" />
            <VerticalStackLayout Grid.Column="1" Padding="0,10,0,0" Spacing="8">
                <controls:SkeletonView HeightRequest="22" WidthRequest="180" CornerRadius="4" />
                <controls:SkeletonView HeightRequest="14" WidthRequest="120" CornerRadius="4" />
                <controls:SkeletonView HeightRequest="14" WidthRequest="100" CornerRadius="4" />
            </VerticalStackLayout>
        </Grid>

        <!-- Rating -->
        <HorizontalStackLayout Padding="16,0,16,12" Spacing="8">
            <controls:SkeletonView HeightRequest="20" WidthRequest="40" CornerRadius="4" />
            <controls:SkeletonView HeightRequest="14" WidthRequest="80" CornerRadius="4" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Action buttons -->
        <Grid ColumnDefinitions="*, *, *" Padding="8,0,8,12">
            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="6">
                <controls:SkeletonView WidthRequest="44" HeightRequest="44" CornerRadius="22" HorizontalOptions="Center" />
                <controls:SkeletonView HeightRequest="12" WidthRequest="40" CornerRadius="4" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                <controls:SkeletonView WidthRequest="44" HeightRequest="44" CornerRadius="22" HorizontalOptions="Center" />
                <controls:SkeletonView HeightRequest="12" WidthRequest="30" CornerRadius="4" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="6">
                <controls:SkeletonView WidthRequest="44" HeightRequest="44" CornerRadius="22" HorizontalOptions="Center" />
                <controls:SkeletonView HeightRequest="12" WidthRequest="55" CornerRadius="4" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,4,16,16" />

        <!-- Synopsis -->
        <VerticalStackLayout Padding="16,0" Spacing="10">
            <controls:SkeletonView HeightRequest="12" WidthRequest="80" CornerRadius="4" />
            <controls:SkeletonView HeightRequest="14" CornerRadius="4" HorizontalOptions="Fill" />
            <controls:SkeletonView HeightRequest="14" CornerRadius="4" HorizontalOptions="Fill" />
            <controls:SkeletonView HeightRequest="14" WidthRequest="200" CornerRadius="4" />
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,16" />

        <!-- Cast -->
        <VerticalStackLayout Padding="16,0" Spacing="10">
            <controls:SkeletonView HeightRequest="12" WidthRequest="40" CornerRadius="4" />
            <HorizontalStackLayout Spacing="14">
                <VerticalStackLayout Spacing="6" WidthRequest="70">
                    <controls:SkeletonView WidthRequest="42" HeightRequest="42" CornerRadius="21" HorizontalOptions="Center" />
                    <controls:SkeletonView HeightRequest="12" WidthRequest="50" CornerRadius="4" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" WidthRequest="70">
                    <controls:SkeletonView WidthRequest="42" HeightRequest="42" CornerRadius="21" HorizontalOptions="Center" />
                    <controls:SkeletonView HeightRequest="12" WidthRequest="50" CornerRadius="4" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" WidthRequest="70">
                    <controls:SkeletonView WidthRequest="42" HeightRequest="42" CornerRadius="21" HorizontalOptions="Center" />
                    <controls:SkeletonView HeightRequest="12" WidthRequest="50" CornerRadius="4" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6" WidthRequest="70">
                    <controls:SkeletonView WidthRequest="42" HeightRequest="42" CornerRadius="21" HorizontalOptions="Center" />
                    <controls:SkeletonView HeightRequest="12" WidthRequest="50" CornerRadius="4" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="16,16" />

        <!-- Reviews -->
        <VerticalStackLayout Padding="16,0,16,24" Spacing="12">
            <controls:SkeletonView HeightRequest="12" WidthRequest="60" CornerRadius="4" />
            <controls:ReviewItemSkeleton />
            <controls:ReviewItemSkeleton />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentView>
