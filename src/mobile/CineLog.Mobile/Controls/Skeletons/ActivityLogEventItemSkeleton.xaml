<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Controls.ActivityLogEventItemSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto">
        <VerticalStackLayout Padding="0,16" Spacing="10">

            <Grid ColumnDefinitions="34,*,58" ColumnSpacing="10">

                <controls:SkeletonView
                    Grid.Column="0"
                    HeightRequest="28"
                    WidthRequest="28"
                    CornerRadius="14"
                    VerticalOptions="Center" />

                <controls:SkeletonView Grid.Column="1" HeightRequest="13" WidthRequest="160" HorizontalOptions="Start" CornerRadius="6" />
            </Grid>
            <controls:SkeletonView HeightRequest="12" WidthRequest="72" HorizontalOptions="Start" CornerRadius="6" />
        </VerticalStackLayout>

        <BoxView Grid.Row="1" Style="{StaticResource ListDivider}" />
    </Grid>
</ContentView>
