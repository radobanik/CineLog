<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Controls.WatchListRowSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="0,0,0,10"
        Padding="12"
        BackgroundColor="{StaticResource Surface}"
        Stroke="{StaticResource Border}"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="52,*" ColumnSpacing="12" HeightRequest="52">

            <controls:SkeletonView
                Grid.Column="0"
                HeightRequest="40"
                WidthRequest="40"
                CornerRadius="20"
                VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <controls:SkeletonView HeightRequest="14" WidthRequest="140" HorizontalOptions="Start" />
                <controls:SkeletonView HeightRequest="10" WidthRequest="80" HorizontalOptions="Start" />
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
