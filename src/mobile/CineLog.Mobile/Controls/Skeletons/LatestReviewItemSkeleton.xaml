<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Controls.LatestReviewItemSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="0,8,0,8"
        Padding="10"
        BackgroundColor="{StaticResource Surface}"
        Stroke="{StaticResource Border}"
        StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="6" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="40,*,58" ColumnSpacing="10">

            <controls:SkeletonView
                Grid.Column="0"
                HeightRequest="28"
                WidthRequest="28"
                CornerRadius="14"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Start">
                <controls:SkeletonView HeightRequest="10" WidthRequest="110" CornerRadius="5" HorizontalOptions="Start" />
                <controls:SkeletonView HeightRequest="13" WidthRequest="130" CornerRadius="5" HorizontalOptions="Start" />
                <controls:SkeletonView HeightRequest="11" WidthRequest="50" CornerRadius="5" HorizontalOptions="Start" />
                <controls:SkeletonView HeightRequest="10" WidthRequest="150" CornerRadius="5" HorizontalOptions="Start" />
                <controls:SkeletonView HeightRequest="10" WidthRequest="80" CornerRadius="5" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <Grid Grid.Column="2" RowDefinitions="76,Auto" RowSpacing="4">
                <controls:SkeletonView
                    Grid.Row="0"
                    HeightRequest="76"
                    WidthRequest="54"
                    CornerRadius="5" />
                <controls:SkeletonView
                    Grid.Row="1"
                    HeightRequest="13"
                    WidthRequest="30"
                    CornerRadius="5"
                    HorizontalOptions="Center" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
