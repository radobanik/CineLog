<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Controls.ActivityLogItemSkeleton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto">
        <Grid
            Padding="0,16"
            ColumnDefinitions="48,*,64"
            ColumnSpacing="12">

            <controls:SkeletonView
                Grid.Column="0"
                HeightRequest="42"
                WidthRequest="42"
                CornerRadius="21"
                VerticalOptions="Start" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="9"
                VerticalOptions="Start">

                <controls:SkeletonView
                    HeightRequest="18"
                    HorizontalOptions="Fill"
                    CornerRadius="9" />

                <controls:SkeletonView
                    HeightRequest="18"
                    HorizontalOptions="Fill"
                    Margin="0,0,48,0"
                    CornerRadius="9" />

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    HeightRequest="58"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Padding="10" Spacing="7">
                        <controls:SkeletonView
                            HeightRequest="12"
                            WidthRequest="82"
                            HorizontalOptions="Start"
                            CornerRadius="6" />

                        <controls:SkeletonView
                            HeightRequest="12"
                            HorizontalOptions="Fill"
                            Margin="0,0,24,0"
                            CornerRadius="6" />
                    </VerticalStackLayout>
                </Border>

                <controls:SkeletonView
                    HeightRequest="14"
                    WidthRequest="72"
                    HorizontalOptions="Start"
                    CornerRadius="7" />
            </VerticalStackLayout>

            <controls:SkeletonView
                Grid.Column="2"
                HeightRequest="86"
                WidthRequest="58"
                CornerRadius="7"
                VerticalOptions="Start" />
        </Grid>

        <BoxView Grid.Row="1" Style="{StaticResource ListDivider}" />
    </Grid>
</ContentView>
