<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Views.WatchList.WatchListMovieRowView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    x:Name="Root">

    <Border
        Margin="0,0,0,10"
        Padding="12"
        BackgroundColor="{StaticResource Surface}"
        Stroke="{StaticResource Border}"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="64,*,44" ColumnSpacing="12">

            <Border
                BackgroundColor="{StaticResource SurfaceVariant}"
                HeightRequest="76"
                StrokeThickness="0"
                WidthRequest="56">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference Root}, Path=OpenCommand}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>

                <Image Aspect="AspectFill" Source="{Binding PosterPath}" />
            </Border>

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="4"
                VerticalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference Root}, Path=OpenCommand}"
                        CommandParameter="{Binding .}" />
                </VerticalStackLayout.GestureRecognizers>

                <Label
                    Style="{StaticResource BodyLargeLabel}"
                    FontAttributes="Bold"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding Title}" />

                <HorizontalStackLayout>
                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="{Binding RatingText}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>

            <Label
                Grid.Column="2"
                FontFamily="FASolid"
                FontSize="16"
                HeightRequest="44"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="{x:Static helpers:FontAwesomeIcons.Times}"
                TextColor="{StaticResource Error}"
                VerticalOptions="Center"
                VerticalTextAlignment="Center"
                WidthRequest="44">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference Root}, Path=RemoveCommand}"
                        CommandParameter="{Binding .}" />
                </Label.GestureRecognizers>
            </Label>

        </Grid>
    </Border>
</ContentView>
