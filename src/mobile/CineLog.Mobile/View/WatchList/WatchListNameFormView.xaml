<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Views.WatchList.WatchListNameFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid IsVisible="{Binding Source={x:Reference Root}, Path=IsOpen}">
        <BoxView Color="#99000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=CancelCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border
            Padding="20"
            BackgroundColor="{StaticResource Surface}"
            HorizontalOptions="Center"
            Stroke="{StaticResource Border}"
            StrokeThickness="1"
            TranslationY="-110"
            VerticalOptions="Center"
            WidthRequest="320">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="16">
                <Label
                    Style="{StaticResource HeadlineMediumLabel}"
                    HorizontalOptions="Center"
                    Text="{Binding Source={x:Reference Root}, Path=Title}" />

                <Entry
                    BackgroundColor="Transparent"
                    Placeholder="List name"
                    PlaceholderColor="{StaticResource TextSecondary}"
                    ReturnCommand="{Binding Source={x:Reference Root}, Path=ConfirmCommand}"
                    Text="{Binding Source={x:Reference Root}, Path=Name}"
                    TextColor="{StaticResource OnSurface}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding Source={x:Reference Root}, Path=CancelCommand}"
                        Text="Cancel" />

                    <Button
                        Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding Source={x:Reference Root}, Path=ConfirmCommand}"
                        Text="Save" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
