<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Views.WatchList.WatchListRowView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:watchListViews="clr-namespace:CineLog.Mobile.Views.WatchList"
    x:Name="Root">

    <VerticalStackLayout>

        <Label
            Margin="0,6,0,8"
            IsVisible="{Binding IsFirstCustom}"
            Style="{StaticResource SectionHeaderLabel}"
            Text="My Lists" />

        <AbsoluteLayout Margin="0,0,0,10" HeightRequest="88">

            <Border
                Padding="12"
                AbsoluteLayout.LayoutBounds="0,0,1,76"
                AbsoluteLayout.LayoutFlags="WidthProportional"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="52,*,44" ColumnSpacing="12">

                    <Border
                        BackgroundColor="{StaticResource SurfaceVariant}"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="40">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="{Binding IconText}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding UsesIconFont}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="FontFamily" Value="FASolid" />
                                    <Setter Property="FontAttributes" Value="None" />
                                </DataTrigger>

                            </Label.Triggers>
                        </Label>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">

                        <Label
                            Style="{StaticResource BodyLargeLabel}"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            Text="{Binding Name}" />

                        <Label
                            Style="{StaticResource CaptionLabel}"
                            Text="{Binding CountText}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding Source={x:Reference Root}, Path=ToggleOptionsCommand}"
                        CommandParameter="{Binding .}"
                        FontSize="20"
                        HeightRequest="40"
                        HorizontalOptions="End"
                        Text="⋯"
                        TextColor="{StaticResource TextSecondary}"
                        VerticalOptions="Center"
                        WidthRequest="40" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <watchListViews:WatchListRowOptionsView
                AbsoluteLayout.LayoutBounds="0.78,16,128,72"
                AbsoluteLayout.LayoutFlags="XProportional"
                DeleteCommand="{Binding Source={x:Reference Root}, Path=DeleteCommand}"
                EditCommand="{Binding Source={x:Reference Root}, Path=EditCommand}"
                IsVisible="{Binding IsOptionsOpen}"
                ZIndex="20" />

        </AbsoluteLayout>

    </VerticalStackLayout>
</ContentView>
