<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Views.Search.UserSearchRowView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    x:Name="Root">

    <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=OpenProfileCommand}" CommandParameter="{Binding .}" />
        </Grid.GestureRecognizers>

        <Border
            BackgroundColor="{StaticResource SurfaceVariant}"
            HeightRequest="34"
            StrokeThickness="0"
            WidthRequest="34">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="17" />
            </Border.StrokeShape>

            <Grid>
                <Image
                    Aspect="AspectFill"
                    IsVisible="{Binding HasAvatar}"
                    Source="{Binding AvatarUrl}" />

                <Label
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasNoAvatar}"
                    Text="{Binding Initial}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Column="1" Spacing="2">
            <Label
                FontAttributes="Bold"
                Style="{StaticResource BodyMediumLabel}"
                Text="{Binding Username}" />

            <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
        </VerticalStackLayout>

        <controls:FollowToggleButtonView
            Grid.Column="2"
            Command="{Binding Source={x:Reference Root}, Path=ToggleFollowCommand}"
            CommandParameter="{Binding .}"
            IsFollowing="{Binding IsFollowing}"
            Text="{Binding FollowButtonText}" />

    </Grid>
</ContentView>
