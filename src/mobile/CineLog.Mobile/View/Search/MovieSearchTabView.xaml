<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Views.Search.MovieSearchTabView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models;assembly=CineLog.Mobile.Core"
    x:Name="Root">

    <Grid Padding="16,0">
        <Grid IsVisible="{Binding ShowHome}">
            <RefreshView
                Command="{Binding RefreshCommand}"
                IsRefreshing="{Binding IsRefreshing, Mode=OneWay}">

                <CollectionView
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding HomeMovies}"
                    RemainingItemsThreshold="6"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                    SelectionMode="None">

                    <CollectionView.Header>
                        <VerticalStackLayout Padding="0,0,0,14" Spacing="12">
                            <Label Style="{StaticResource SectionHeaderLabel}" Text="Browse by genre" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                RowDefinitions="64,64"
                                RowSpacing="10">

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    BackgroundColor="#5A1215"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="Action"
                                        TextColor="{StaticResource OnBackground}"
                                        VerticalOptions="Center" />

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToCategoryCommand}"
                                            CommandParameter="{x:Static models:MovieCategory.Action}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    BackgroundColor="#16225F"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="Drama"
                                        TextColor="{StaticResource OnBackground}"
                                        VerticalOptions="Center" />

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToCategoryCommand}"
                                            CommandParameter="{x:Static models:MovieCategory.Drama}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    BackgroundColor="#073A46"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="Sci-Fi"
                                        TextColor="{StaticResource OnBackground}"
                                        VerticalOptions="Center" />

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToCategoryCommand}"
                                            CommandParameter="{x:Static models:MovieCategory.Scifi}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource Surface}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        Text="Horror"
                                        TextColor="{StaticResource OnBackground}"
                                        VerticalOptions="Center" />

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToCategoryCommand}"
                                            CommandParameter="{x:Static models:MovieCategory.Horror}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="10"
                            Orientation="Vertical"
                            Span="3"
                            VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MovieItem">
                            <Grid>
                                <controls:MoviePosterCard
                                    Title="{Binding Title}"
                                    PosterPath="{Binding PosterPath}"
                                    RatingText="{Binding RatingText}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToMovieCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <controls:MovieSearchHomeSkeleton IsVisible="{Binding ShowHomeSkeleton}" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

        <CollectionView
            x:Name="SkeletonGrid"
            IsVisible="{Binding ShowSkeleton}"
            ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="10"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <controls:SkeletonMoviePosterCard />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid IsVisible="{Binding ShowResults}">
            <RefreshView
                Command="{Binding RefreshCommand}"
                IsRefreshing="{Binding IsRefreshing, Mode=OneWay}">

                <CollectionView
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding Movies}"
                    RemainingItemsThreshold="4"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                    SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="10"
                            Orientation="Vertical"
                            Span="3"
                            VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MovieItem">
                            <Grid>
                                <controls:MoviePosterCard
                                    Title="{Binding Title}"
                                    PosterPath="{Binding PosterPath}"
                                    RatingText="{Binding RatingText}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.GoToMovieCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <ActivityIndicator
                            Margin="0,8"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

        <VerticalStackLayout
            HorizontalOptions="Center"
            IsVisible="{Binding ShowNoResults}"
            Spacing="12"
            VerticalOptions="Center">

            <Label
                FontSize="40"
                HorizontalOptions="Center"
                Style="{StaticResource PrimaryIconLabel}"
                Text="{x:Static helpers:FontAwesomeIcons.SearchMinus}" />

            <Label
                HorizontalOptions="Center"
                Style="{StaticResource BodyMediumLabel}"
                Text="No results found" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
