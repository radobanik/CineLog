<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CineLog.Mobile.Views.Search.PeopleSearchTabView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:searchViews="clr-namespace:CineLog.Mobile.Views.Search"
    xmlns:searchVm="clr-namespace:CineLog.Mobile.Core.ViewModels.Search;assembly=CineLog.Mobile.Core"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    x:Name="Root">

    <Grid Padding="16,0">

        <!--  Home mode: secondary tabs (Popular / Following)  -->
        <Grid IsVisible="{Binding ShowHome}" RowDefinitions="Auto,Auto,*">

            <BoxView Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource ListDivider}" />

            <HorizontalStackLayout Grid.Row="1" Margin="0,0,0,12" Spacing="8">
                <Button
                    Command="{Binding SelectPopularCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Popular">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsPopularSelected}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button
                    Command="{Binding SelectFollowingCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Following">
                    <Button.Triggers>
                        <DataTrigger
                            Binding="{Binding IsFollowingSelected}"
                            TargetType="Button"
                            Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!--  Popular tab  -->
            <Grid Grid.Row="2" IsVisible="{Binding IsPopularSelected}">
                <CollectionView ItemsSource="{Binding RecommendedUsers}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                            <searchViews:UserSearchRowView
                                OpenProfileCommand="{Binding Source={x:Reference Root}, Path=BindingContext.OpenProfileCommand}"
                                ToggleFollowCommand="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleFollowCommand}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <controls:PeopleTabSkeleton InputTransparent="True" IsVisible="{Binding ShowHomeSkeleton}" />
            </Grid>

            <!--  Following tab  -->
            <Grid Grid.Row="2" IsVisible="{Binding IsFollowingSelected}">
                <CollectionView ItemsSource="{Binding FollowingUsers}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                            <searchViews:UserSearchRowView
                                OpenProfileCommand="{Binding Source={x:Reference Root}, Path=BindingContext.OpenProfileCommand}"
                                ToggleFollowCommand="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleFollowCommand}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,8" Spacing="4">
                            <ActivityIndicator
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}" />
                            <Button
                                Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding CanLoadMore}"
                                Style="{StaticResource TextButton}"
                                Text="Load more" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
                <controls:PeopleTabSkeleton InputTransparent="True" IsVisible="{Binding ShowHomeSkeleton}" />
            </Grid>

        </Grid>

        <!--  Search results  -->
        <CollectionView
            IsVisible="{Binding ShowResults}"
            ItemsSource="{Binding SearchResults}"
            RemainingItemsThreshold="4"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                    <searchViews:UserSearchRowView
                        OpenProfileCommand="{Binding Source={x:Reference Root}, Path=BindingContext.OpenProfileCommand}"
                        ToggleFollowCommand="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleFollowCommand}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ActivityIndicator
                    Margin="0,8"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />
            </CollectionView.Footer>
        </CollectionView>

        <!--  No results  -->
        <VerticalStackLayout
            HorizontalOptions="Center"
            IsVisible="{Binding ShowNoResults}"
            Spacing="12"
            VerticalOptions="Center">
            <Label
                FontSize="40"
                HorizontalOptions="Center"
                Style="{StaticResource PrimaryIconLabel}"
                Text="{x:Static helpers:FontAwesomeIcons.SearchMinus}" />
            <Label
                HorizontalOptions="Center"
                Style="{StaticResource BodyMediumLabel}"
                Text="No results found" />
        </VerticalStackLayout>

    </Grid>
</ContentView>
