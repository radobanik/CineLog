<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.Movies.AddToWatchlistPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Movies;assembly=CineLog.Mobile.Core"
    xmlns:watchListVm="clr-namespace:CineLog.Mobile.Core.ViewModels.WatchList;assembly=CineLog.Mobile.Core"
    x:DataType="vm:AddToWatchlistViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}"
    ShowMenuButton="false">

    <Grid Padding="24" RowDefinitions="Auto,*">

        <Grid Padding="0,4,0,16" ColumnDefinitions="44,*">
            <Button
                Padding="0"
                BackgroundColor="Transparent"
                Command="{Binding GoBackCommand}"
                FontSize="28"
                Text="‹"
                TextColor="{StaticResource OnBackground}" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="22"
                LineBreakMode="TailTruncation"
                Text="Add to Watchlist"
                TextColor="{StaticResource OnBackground}"
                VerticalOptions="Center" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Lists}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="watchListVm:WatchListRowViewModel">
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddToWatchlistViewModel}}, Path=AddToWatchlistCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                HeightRequest="52"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="52">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    HorizontalOptions="Center"
                                    Text="{Binding IconText}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource OnSurface}" />
                                <Label
                                    FontSize="15"
                                    Text="{Binding CountText}"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label
                    Style="{StaticResource CaptionLabel}"
                    Text="No watchlists yet."
                    Margin="0,8,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</pages:BasePage>
