<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.Movies.MovieWatchListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    x:Name="ThisPage"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}"
    ShowMenuButton="false">

    <Grid Padding="24" RowDefinitions="Auto,*">

        <Grid Padding="0,4,0,16" ColumnDefinitions="44,*">

            <Button
                Padding="0"
                BackgroundColor="Transparent"
                Command="{Binding BackCommand}"
                FontSize="28"
                Text="‹"
                TextColor="{StaticResource OnBackground}" />

            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="22"
                LineBreakMode="TailTruncation"
                Text="{Binding SelectedRow.Name}"
                TextColor="{StaticResource OnBackground}"
                VerticalOptions="Center" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Movies}"
            RemainingItemsThreshold="3"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="64,*,44" ColumnSpacing="12">

                            <Border
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                HeightRequest="76"
                                StrokeThickness="0"
                                WidthRequest="56">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <Image Aspect="AspectFill" Source="{Binding PosterPath}" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4"
                                VerticalOptions="Center">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding Title}"
                                    TextColor="{StaticResource OnSurface}" />

                                <Label
                                    FontSize="13"
                                    Text="{Binding RatingText}"
                                    TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveMovieCommand}"
                                CommandParameter="{Binding .}"
                                HeightRequest="40"
                                Text="✕"
                                TextColor="{StaticResource Error}"
                                WidthRequest="40" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ActivityIndicator
                    Margin="0,12"
                    IsRunning="{Binding IsLoadingMore}"
                    IsVisible="{Binding IsLoadingMore}"
                    Color="{StaticResource Primary}" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</pages:BasePage>
