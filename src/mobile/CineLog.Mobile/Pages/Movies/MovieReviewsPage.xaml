<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.Movies.MovieReviewsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models.Review;assembly=CineLog.Mobile.Core"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Movies;assembly=CineLog.Mobile.Core"
    x:DataType="vm:MovieReviewsViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}"
    ShowMenuButton="false">

    <Grid Padding="6,24,6,24">
        <CollectionView
            ItemsSource="{Binding Reviews}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ReviewListItem">
                    <controls:ReviewListCard
                        IsMovieMode="{Binding Source={RelativeSource AncestorType={x:Type vm:MovieReviewsViewModel}}, Path=IsMovieMode}"
                        LikeCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MovieReviewsViewModel}}, Path=ToggleLikeCommand}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="0,8,0,24">
                    <Button
                        Text="Load more"
                        Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding CanLoadMore}"
                        BackgroundColor="{StaticResource Surface}"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48" />
                    <ActivityIndicator
                        Margin="0,12"
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}"
                        Color="{StaticResource Primary}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</pages:BasePage>
