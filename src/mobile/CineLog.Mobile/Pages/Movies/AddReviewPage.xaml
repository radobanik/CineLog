<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.Movies.AddReviewPage"
    x:DataType="vm:AddReviewViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Movies;assembly=CineLog.Mobile.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource Background}"
    ShowMenuButton="false">

    <Grid>
        <ScrollView IsVisible="{Binding IsNotBusy}">
            <VerticalStackLayout Padding="20,16,20,48" Spacing="0">

                <!-- Full movie info (create mode) -->
                <Grid
                    ColumnDefinitions="Auto, *"
                    ColumnSpacing="14"
                    Margin="0,0,0,16"
                    IsVisible="{Binding IsNotEditMode}">

                    <Border
                        Grid.Column="0"
                        WidthRequest="70"
                        HeightRequest="100"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Image
                            Source="{Binding Movie.PosterPath}"
                            Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        VerticalOptions="Center">
                        <Label
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="{Binding Movie.Title}"
                            LineBreakMode="TailTruncation"
                            MaxLines="2" />
                        <Label
                            Style="{StaticResource CaptionLabel}"
                            Text="{Binding Movie.Subtitle}" />
                        <Label
                            Style="{StaticResource BodyMediumLabel}"
                            Text="{Binding Movie.Director}"
                            IsVisible="{Binding Movie.Director, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Movie title only (edit mode) -->
                <Label
                    Style="{StaticResource HeadlineMediumLabel}"
                    Text="{Binding MovieTitle}"
                    LineBreakMode="TailTruncation"
                    MaxLines="2"
                    Margin="0,0,0,16"
                    IsVisible="{Binding IsEditMode}" />

                <BoxView Style="{StaticResource ListDivider}" Margin="0,4,0,20" />

                <!-- Rating section -->
                <Label
                    Margin="4,0,0,12"
                    Style="{StaticResource OverlineLabel}"
                    Text="RATING" />

                <Grid ColumnDefinitions="52, *, 52" Margin="0,0,0,8">

                    <Border
                        Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DecreaseRatingCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontFamily="FASolid"
                            FontSize="16"
                            Text="{x:Static helpers:FontAwesomeIcons.Minus}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding CanDecrease}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding CanDecrease}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <HorizontalStackLayout
                            Spacing="3"
                            HorizontalOptions="Center"
                            BindableLayout.ItemsSource="{Binding Stars}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:StarDisplayItem">
                                    <Grid>
                                        <!-- Grey full star: always visible as background -->
                                        <Label
                                            FontFamily="FASolid"
                                            FontSize="26"
                                            Text="{x:Static helpers:FontAwesomeIcons.Star}"
                                            TextColor="{StaticResource TextDisabled}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                        <!-- Colored full star: shown when full -->
                                        <Label
                                            FontFamily="FASolid"
                                            FontSize="26"
                                            Text="{x:Static helpers:FontAwesomeIcons.Star}"
                                            TextColor="{StaticResource Primary}"
                                            IsVisible="{Binding IsFull}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                        <!-- Colored half star: overlays grey star, left=colored, right=grey -->
                                        <Label
                                            FontFamily="FASolid"
                                            FontSize="26"
                                            Text="{x:Static helpers:FontAwesomeIcons.StarHalf}"
                                            TextColor="{StaticResource Primary}"
                                            IsVisible="{Binding IsHalf}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="{Binding RatingText}"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding IncreaseRatingCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontFamily="FASolid"
                            FontSize="16"
                            Text="{x:Static helpers:FontAwesomeIcons.Plus}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding CanIncrease}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding CanIncrease}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                </Grid>

                <BoxView Style="{StaticResource ListDivider}" Margin="0,16" />

                <!-- Review text section -->
                <Label
                    Margin="4,0,0,8"
                    Style="{StaticResource OverlineLabel}"
                    Text="REVIEW (OPTIONAL)" />

                <Border Style="{StaticResource InputFieldBorder}">
                    <Editor
                        Text="{Binding ReviewText}"
                        Placeholder="Write your thoughts about this film..."
                        TextColor="{StaticResource OnBackground}"
                        PlaceholderColor="{StaticResource TextSecondary}"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        AutoSize="Disabled"
                        HeightRequest="120"
                        Margin="16,8" />
                </Border>

                <!-- Action buttons -->
                <Button
                    Command="{Binding SubmitCommand}"
                    HorizontalOptions="Fill"
                    Margin="0,32,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Text="{Binding SubmitButtonText}" />

                <Button
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill"
                    Margin="0,12,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Text="Cancel" />

                <Button
                    Command="{Binding DeleteReviewCommand}"
                    HorizontalOptions="Fill"
                    IsVisible="{Binding IsEditMode}"
                    Margin="0,12,0,0"
                    Style="{StaticResource DangerButton}"
                    Text="Delete Review" />

            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>

</pages:BasePage>
