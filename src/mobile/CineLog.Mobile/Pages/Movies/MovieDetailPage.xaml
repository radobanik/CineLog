<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.Movies.MovieDetailPage"
    x:DataType="vm:MovieDetailViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models.Movies;assembly=CineLog.Mobile.Core"
    xmlns:review="clr-namespace:CineLog.Mobile.Core.Models.Review;assembly=CineLog.Mobile.Core"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Movies;assembly=CineLog.Mobile.Core"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    ShowNavBar="False">

    <Grid>
        <ScrollView IsVisible="{Binding IsNotBusy}">
        <VerticalStackLayout Spacing="0">

            <Grid HeightRequest="220">
                <Image
                    Source="{Binding Movie.BackdropPath}"
                    Aspect="AspectFill" />

                <BoxView
                    VerticalOptions="End"
                    HeightRequest="220">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="#99000000" Offset="0.55" />
                            <GradientStop Color="#DD000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

            </Grid>

            <Grid
                ColumnDefinitions="Auto, *"
                Padding="16,0,16,12">

                <Border
                    Grid.Column="0"
                    WidthRequest="90"
                    HeightRequest="130"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    Margin="0,-50,14,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Image
                        Source="{Binding Movie.PosterPath}"
                        Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Padding="0,10,0,0"
                    Spacing="4">
                    <Label
                        Style="{StaticResource HeadlineMediumLabel}"
                        Text="{Binding Movie.Title}" />
                    <Label
                        Style="{StaticResource CaptionLabel}"
                        Text="{Binding Movie.Subtitle}" />
                    <Label
                        Style="{StaticResource BodyMediumLabel}"
                        Text="{Binding Movie.Director}"
                        IsVisible="{Binding Movie.Director, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout Padding="16,0,16,12" Spacing="8">
                <Label
                    Style="{StaticResource HeadlineMediumLabel}"
                    FontSize="16"
                    Text="{Binding Movie.RatingText}"
                    VerticalOptions="Center" />
                <Label
                    Style="{StaticResource CaptionLabel}"
                    Text="{Binding Movie.RatingsCountText}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid
                ColumnDefinitions="*, *, *, *"
                Padding="8,0,8,12">

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="6">
                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label
                            FontFamily="FASolid"
                            FontSize="16"
                            TextColor="{StaticResource OnSurface}"
                            Text="{x:Static helpers:FontAwesomeIcons.Eye}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label Style="{StaticResource CaptionLabel}" Text="Watched" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLikeMovieCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label
                            FontFamily="FASolid"
                            FontSize="16"
                            Text="{x:Static helpers:FontAwesomeIcons.Heart}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLiked}" Value="True">
                                    <Setter Property="TextColor" Value="#E53935" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsLiked}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Label Style="{StaticResource CaptionLabel}" Text="Like" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAddToWatchlistCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label
                            FontFamily="FASolid"
                            FontSize="16"
                            TextColor="{StaticResource OnSurface}"
                            Text="{x:Static helpers:FontAwesomeIcons.Bookmark}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label Style="{StaticResource CaptionLabel}" Text="Watchlist" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="6">
                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Label
                            FontFamily="FASolid"
                            FontSize="16"
                            TextColor="{StaticResource OnSurface}"
                            Text="{x:Static helpers:FontAwesomeIcons.Share}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label Style="{StaticResource CaptionLabel}" Text="Share" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>

            <BoxView Style="{StaticResource ListDivider}" Margin="16,4,16,16" />

            <VerticalStackLayout Padding="16,0" Spacing="10">
                <Label Style="{StaticResource SectionHeaderLabel}" Text="SYNOPSIS" />
                <Label
                    Style="{StaticResource BodyMediumLabel}"
                    Text="{Binding Movie.Overview}"
                    IsVisible="{Binding HasNoOverview, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,0,0,4" />
                <Label
                    Style="{StaticResource CaptionLabel}"
                    Text="Synopsis unavailable."
                    IsVisible="{Binding HasNoOverview}"
                    Margin="0,0,0,4" />
            </VerticalStackLayout>

            <BoxView Style="{StaticResource ListDivider}" Margin="16,16" />

            <VerticalStackLayout Padding="16,0" Spacing="10">
                <Label Style="{StaticResource SectionHeaderLabel}" Text="CAST" />

                <Label
                    Style="{StaticResource CaptionLabel}"
                    Text="Cast unavailable."
                    IsVisible="{Binding HasNoCast}"
                    Margin="0,0,0,4" />

                <ScrollView
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    IsVisible="{Binding HasNoCast, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,0,0,4">
                    <HorizontalStackLayout
                        Spacing="14"
                        BindableLayout.ItemsSource="{Binding Cast}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CastMemberItem">
                                <VerticalStackLayout WidthRequest="70" Spacing="6">
                                    <Border
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="{StaticResource Surface}"
                                        Stroke="{StaticResource Border}"
                                        StrokeThickness="1"
                                        HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="21" />
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Initial}"
                                            Style="{StaticResource HeadlineMediumLabel}"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <Label
                                        Text="{Binding Name}"
                                        Style="{StaticResource CaptionLabel}"
                                        MaxLines="2"
                                        LineBreakMode="WordWrap"
                                        HorizontalTextAlignment="Center"
                                        HeightRequest="32" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <BoxView Style="{StaticResource ListDivider}" Margin="16,16" />

            <VerticalStackLayout Padding="16,0,16,24" Spacing="0">
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                    <Label
                        Grid.Column="0"
                        Style="{StaticResource SectionHeaderLabel}"
                        Text="REVIEWS" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource AccentLabel}"
                        Text="{Binding ReviewsCountText}"
                        VerticalTextAlignment="Center"
                        IsVisible="{Binding ReviewsCountText, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenReviewsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Label
                    Style="{StaticResource CaptionLabel}"
                    Text="No reviews yet."
                    IsVisible="{Binding HasNoReviews}"
                    Margin="0,8,0,0" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reviews}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="review:ReviewListItem">
                            <controls:ReviewListCard
                                IsMovieMode="True"
                                LikeCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MovieDetailViewModel}}, Path=ToggleLikeCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
        <Label FontSize="18"
               Style="{StaticResource IconLabel}"
               TextColor="{StaticResource OnBackground}"
               Text="{x:Static helpers:FontAwesomeIcons.ChevronLeft}"
               WidthRequest="52"
               HeightRequest="52"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>

</pages:BasePage>
