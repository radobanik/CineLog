<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.MainPages.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models;assembly=CineLog.Mobile.Core"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:searchVm="clr-namespace:CineLog.Mobile.Core.ViewModels.Search;assembly=CineLog.Mobile.Core"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Search;assembly=CineLog.Mobile.Core"
    Title="Search"
    x:DataType="vm:SearchViewModel"
    ShowMenuButton="True">

    <Grid RowDefinitions="Auto,Auto,*">

        <Border
            Grid.Row="0"
            Margin="16,12,16,8"
            Style="{StaticResource InputFieldBorder}">
            <Grid Padding="16,0" ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource SecondaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.Search}"
                    VerticalOptions="Center" />

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    Margin="10,0"
                    Placeholder="Search films, people..."
                    Style="{StaticResource CleanEntry}"
                    Text="{Binding SearchQuery}" />

                <Label
                    Grid.Column="2"
                    IsVisible="{Binding HasQuery}"
                    Style="{StaticResource SecondaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.Times}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <HorizontalStackLayout
            Grid.Row="1"
            Margin="16,0,16,8"
            Spacing="8">
            <Button
                Command="{Binding SelectMoviesCommand}"
                Style="{StaticResource SecondaryButton}"
                Text="Movies">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsMoviesSelected}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Command="{Binding SelectPeopleCommand}"
                Style="{StaticResource SecondaryButton}"
                Text="People">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsPeopleSelected}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="2" Padding="16,0">

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding ShowMovieEmptyState}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    FontSize="40"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.Search}" />
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource BodyMediumLabel}"
                    Text="Search for films" />
            </VerticalStackLayout>

            <CollectionView x:Name="SkeletonGrid" IsVisible="{Binding ShowSkeleton}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controls:SkeletonMoviePosterCard />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView
                IsVisible="{Binding ShowMovieResults}"
                ItemsSource="{Binding Movies}"
                RemainingItemsThreshold="4"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MovieItem">
                        <Grid>
                            <controls:MoviePosterCard
                                Title="{Binding Title}"
                                PosterPath="{Binding PosterPath}"
                                RatingText="{Binding RatingText}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=GoToMovieCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        Margin="0,8"
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}" />
                </CollectionView.Footer>
            </CollectionView>

            <CollectionView
                IsVisible="{Binding ShowPeopleHome}"
                ItemsSource="{Binding FollowingUsers}"
                RemainingItemsThreshold="4"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,0,0,12" Spacing="10">
                        <Label Style="{StaticResource SectionHeaderLabel}" Text="Popular reviewers" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecommendedUsers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                                    <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
                                        <Border
                                            BackgroundColor="{StaticResource SurfaceVariant}"
                                            HeightRequest="34"
                                            WidthRequest="34">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="17" />
                                            </Border.StrokeShape>
                                            <Label
                                                HorizontalOptions="Center"
                                                Text="{Binding Initial}"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                Style="{StaticResource BodyMediumLabel}"
                                                Text="{Binding Username}" />
                                            <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:BasePage}}, Path=BindingContext.ToggleFollowCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="34"
                                            Style="{StaticResource PrimaryButton}"
                                            Text="{Binding FollowButtonText}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource ListDivider}" />
                        <Label Style="{StaticResource SectionHeaderLabel}" Text="Following" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                        <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
                            <Border
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                HeightRequest="34"
                                WidthRequest="34">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Label
                                    HorizontalOptions="Center"
                                    Text="{Binding Initial}"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyMediumLabel}"
                                    Text="{Binding Username}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pages:BasePage}}, Path=BindingContext.ToggleFollowCommand}"
                                CommandParameter="{Binding .}"
                                HeightRequest="34"
                                Style="{StaticResource SecondaryButton}"
                                Text="{Binding FollowButtonText}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        Margin="0,8"
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}" />
                </CollectionView.Footer>
            </CollectionView>

            <CollectionView
                IsVisible="{Binding ShowPeopleResults}"
                ItemsSource="{Binding Users}"
                RemainingItemsThreshold="4"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                        <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
                            <Border
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                HeightRequest="34"
                                WidthRequest="34">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>
                                <Label
                                    HorizontalOptions="Center"
                                    Text="{Binding Initial}"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyMediumLabel}"
                                    Text="{Binding Username}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type pages:BasePage}}, Path=BindingContext.ToggleFollowCommand}"
                                CommandParameter="{Binding .}"
                                HeightRequest="34"
                                Style="{StaticResource PrimaryButton}"
                                Text="{Binding FollowButtonText}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        Margin="0,8"
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}" />
                </CollectionView.Footer>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding ShowNoResults}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    FontSize="40"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.SearchMinus}" />
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource BodyMediumLabel}"
                    Text="No results found" />
            </VerticalStackLayout>

        </Grid>
    </Grid>

</pages:BasePage>
