<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.MainPages.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models;assembly=CineLog.Mobile.Core"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:searchVm="clr-namespace:CineLog.Mobile.Core.ViewModels.Search;assembly=CineLog.Mobile.Core"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Search;assembly=CineLog.Mobile.Core"
    x:Name="SearchRoot"
    Title="Search"
    x:DataType="vm:SearchViewModel"
    ShowMenuButton="True">

    <pages:BasePage.Resources>
        <Style
            x:Key="FollowToggleButton"
            BasedOn="{StaticResource PrimaryButton}"
            TargetType="Button">
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="WidthRequest" Value="92" />
            <Setter Property="MinimumWidthRequest" Value="92" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
            <Setter Property="BorderColor" Value="{StaticResource Primary}" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </pages:BasePage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <Border
            Grid.Row="0"
            Margin="16,12,16,8"
            Style="{StaticResource InputFieldBorder}">
            <Grid Padding="16,0" ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource SecondaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.Search}"
                    VerticalOptions="Center" />

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    Margin="10,0"
                    Placeholder="Search films, people..."
                    Style="{StaticResource CleanEntry}"
                    Text="{Binding SearchQuery}" />

                <Label
                    Grid.Column="2"
                    IsVisible="{Binding HasQuery}"
                    Style="{StaticResource SecondaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.Times}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <HorizontalStackLayout
            Grid.Row="1"
            Margin="16,0,16,8"
            Spacing="8">
            <Button
                Command="{Binding SelectMoviesCommand}"
                Style="{StaticResource SecondaryButton}"
                Text="Movies">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsMoviesSelected}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Command="{Binding SelectPeopleCommand}"
                Style="{StaticResource SecondaryButton}"
                Text="People">
                <Button.Triggers>
                    <DataTrigger
                        Binding="{Binding IsPeopleSelected}"
                        TargetType="Button"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
                        <Setter Property="BorderWidth" Value="0" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <Grid Grid.Row="2" Padding="16,0">

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding ShowMovieEmptyState}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    FontSize="40"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.Search}" />
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource BodyMediumLabel}"
                    Text="Search for films" />
            </VerticalStackLayout>

            <CollectionView x:Name="SkeletonGrid" IsVisible="{Binding ShowSkeleton}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <controls:SkeletonMoviePosterCard />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView
                IsVisible="{Binding ShowMovieResults}"
                ItemsSource="{Binding Movies}"
                RemainingItemsThreshold="4"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="10"
                        Orientation="Vertical"
                        Span="3"
                        VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MovieItem">
                        <Grid>
                            <controls:MoviePosterCard
                                Title="{Binding Title}"
                                PosterPath="{Binding PosterPath}"
                                RatingText="{Binding RatingText}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=GoToMovieCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        Margin="0,8"
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}" />
                </CollectionView.Footer>
            </CollectionView>

            <Grid
                IsVisible="{Binding ShowPeopleHome}"
                RowDefinitions="*,*"
                RowSpacing="12">

                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                    <Label
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Style="{StaticResource SectionHeaderLabel}"
                        Text="Popular reviewers" />

                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding RecommendedUsers}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                                <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
                                    <Border
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        HeightRequest="34"
                                        StrokeThickness="0"
                                        WidthRequest="34">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="17" />
                                        </Border.StrokeShape>

                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding HasAvatar}"
                                                Source="{Binding AvatarUrl}" />

                                            <Label
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding HasNoAvatar}"
                                                Text="{Binding Initial}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            Style="{StaticResource BodyMediumLabel}"
                                            Text="{Binding Username}" />
                                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding Source={x:Reference SearchRoot}, Path=BindingContext.ToggleFollowCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource FollowToggleButton}"
                                        Text="{Binding FollowButtonText}">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFollowing}"
                                                TargetType="Button"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}" />
                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                <Setter Property="BorderColor" Value="{StaticResource SurfaceVariant}" />
                                                <Setter Property="BorderWidth" Value="0" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <BoxView
                    Grid.Row="0"
                    Style="{StaticResource ListDivider}"
                    VerticalOptions="End" />

                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <Label
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Style="{StaticResource SectionHeaderLabel}"
                        Text="Following" />

                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding FollowingUsers}"
                        RemainingItemsThreshold="4"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                                <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
                                    <Border
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        HeightRequest="34"
                                        StrokeThickness="0"
                                        WidthRequest="34">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="17" />
                                        </Border.StrokeShape>

                                        <Grid>
                                            <Image
                                                Aspect="AspectFill"
                                                IsVisible="{Binding HasAvatar}"
                                                Source="{Binding AvatarUrl}" />

                                            <Label
                                                HorizontalOptions="Center"
                                                IsVisible="{Binding HasNoAvatar}"
                                                Text="{Binding Initial}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label
                                            FontAttributes="Bold"
                                            Style="{StaticResource BodyMediumLabel}"
                                            Text="{Binding Username}" />
                                        <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding Source={x:Reference SearchRoot}, Path=BindingContext.ToggleFollowCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource FollowToggleButton}"
                                        Text="{Binding FollowButtonText}">
                                        <Button.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsFollowing}"
                                                TargetType="Button"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}" />
                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                <Setter Property="BorderColor" Value="{StaticResource SurfaceVariant}" />
                                                <Setter Property="BorderWidth" Value="0" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.Footer>
                            <ActivityIndicator
                                Margin="0,8"
                                IsRunning="{Binding IsLoadingMore}"
                                IsVisible="{Binding IsLoadingMore}" />
                        </CollectionView.Footer>
                    </CollectionView>
                </Grid>
            </Grid>

            <CollectionView
                IsVisible="{Binding ShowPeopleResults}"
                ItemsSource="{Binding Users}"
                RemainingItemsThreshold="4"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="searchVm:UserSearchRowViewModel">
                        <Grid Padding="0,8" ColumnDefinitions="44,*,Auto">
                            <Border
                                BackgroundColor="{StaticResource SurfaceVariant}"
                                HeightRequest="34"
                                StrokeThickness="0"
                                WidthRequest="34">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>

                                <Grid>
                                    <Image
                                        Aspect="AspectFill"
                                        IsVisible="{Binding HasAvatar}"
                                        Source="{Binding AvatarUrl}" />

                                    <Label
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding HasNoAvatar}"
                                        Text="{Binding Initial}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    FontAttributes="Bold"
                                    Style="{StaticResource BodyMediumLabel}"
                                    Text="{Binding Username}" />
                                <Label Style="{StaticResource CaptionLabel}" Text="{Binding ReviewsText}" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Command="{Binding Source={x:Reference SearchRoot}, Path=BindingContext.ToggleFollowCommand}"
                                CommandParameter="{Binding .}"
                                Style="{StaticResource FollowToggleButton}"
                                Text="{Binding FollowButtonText}">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsFollowing}"
                                        TargetType="Button"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariant}" />
                                        <Setter Property="TextColor" Value="{StaticResource Error}" />
                                        <Setter Property="BorderColor" Value="{StaticResource SurfaceVariant}" />
                                        <Setter Property="BorderWidth" Value="0" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        Margin="0,8"
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}" />
                </CollectionView.Footer>
            </CollectionView>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding ShowNoResults}"
                Spacing="12"
                VerticalOptions="Center">
                <Label
                    FontSize="40"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryIconLabel}"
                    Text="{x:Static helpers:FontAwesomeIcons.SearchMinus}" />
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource BodyMediumLabel}"
                    Text="No results found" />
            </VerticalStackLayout>

        </Grid>
    </Grid>

</pages:BasePage>
