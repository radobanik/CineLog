<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    x:Class="CineLog.Mobile.Pages.MainPages.WatchListsPage"
    ShowMenuButton="True"
    Title="WatchLists"
    BackgroundColor="{StaticResource Background}">

    <Grid Padding="24" RowDefinitions="*">

        <Grid IsVisible="{Binding ShowWatchLists}">

            <RefreshView Command="{Binding LoadCommand}">
                <CollectionView
                    ItemsSource="{Binding Lists}"
                    SelectionMode="None"
                    Margin="0,8,0,88">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Padding="16"
                                BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="52,*,88" ColumnSpacing="12">

                                    <Border
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding IconText}"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="20"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="2"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Name}"
                                            TextColor="{StaticResource OnSurface}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding CountText}"
                                            TextColor="{StaticResource TextSecondary}"
                                            FontSize="13" />
                                    </VerticalStackLayout>

                                    <Grid
                                        Grid.Column="2"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        WidthRequest="88">

                                        <Button
                                            Text="⋯"
                                            FontSize="24"
                                            Padding="0"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            HorizontalOptions="End"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextSecondary}"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleWatchListOptionsCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Border
                                            IsVisible="{Binding IsOptionsOpen}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            Margin="0,0,38,0"
                                            Padding="10,8"
                                            BackgroundColor="{StaticResource Overlay}"
                                            Stroke="{StaticResource Border}"
                                            StrokeThickness="1"
                                            ZIndex="10">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="8">
                                                <Label
                                                    Text="Edit"
                                                    FontSize="14"
                                                    TextColor="{StaticResource OnSurface}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartEditWatchListCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>

                                                <Label
                                                    Text="Delete"
                                                    FontSize="14"
                                                    TextColor="{StaticResource Error}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteWatchListCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenWatchListCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Grid
                IsVisible="{Binding IsCreatingWatchList}"
                BackgroundColor="#99000000"
                ZIndex="20">

                <Border
                    Padding="20"
                    WidthRequest="320"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1">        

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <Label
                            Text="New watchlist"
                            TextColor="{StaticResource OnSurface}"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />       

                        <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                            <Entry
                    Text="{Binding NewWatchListName}"
                    Placeholder="List name"
                    PlaceholderColor="{StaticResource TextSecondary}"
                    TextColor="{StaticResource OnSurface}"
                    ReturnCommand="{Binding ConfirmCreateWatchListCommand}"
                    BackgroundColor="Transparent" />

                            <Button
                    Grid.Column="1"
                    Text="✓"
                    FontSize="18"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Command="{Binding ConfirmCreateWatchListCommand}" />
                        </Grid>

                        <Button
                Text="Cancel"
                BackgroundColor="Transparent"
                TextColor="{StaticResource TextSecondary}"
                Command="{Binding CancelCreateWatchListCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>


            <Button
                Text="+"
                FontSize="28"
                FontAttributes="Bold"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,0,16"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource OnPrimary}"
                Command="{Binding ShowCreateWatchListCommand}" />
        </Grid>

        <Grid IsVisible="{Binding ShowMovies}" RowDefinitions="Auto,*">

            <Grid ColumnDefinitions="44,*" Padding="0,4,0,16">
                <Button
                    Text="‹"
                    FontSize="28"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource OnBackground}"
                    Command="{Binding BackToListsCommand}" />

                <Label
                    Grid.Column="1"
                    Text="{Binding SelectedWatchList.Name}"
                    TextColor="{StaticResource OnBackground}"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Movies}"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="64,*,44" ColumnSpacing="12">

                                <Border
                                    WidthRequest="56"
                                    HeightRequest="76"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    StrokeThickness="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>

                                    <Image
                                        Source="{Binding PosterPath}"
                                        Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Title}"
                                        TextColor="{StaticResource OnSurface}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding RatingText}"
                                        TextColor="{StaticResource Primary}"
                                        FontSize="13" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    Text="✕"
                                    Padding="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Error}"
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveMovieCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}"
                        Color="{StaticResource Primary}"
                        Margin="0,12" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</pages:BasePage>
