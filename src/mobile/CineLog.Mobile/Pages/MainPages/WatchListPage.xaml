<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.MainPages.WatchListsPage"
    x:Name="ThisPage"
    x:DataType="vm:WatchListViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models;assembly=CineLog.Mobile.Core"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.WatchList;assembly=CineLog.Mobile.Core"
    xmlns:watchlist="clr-namespace:CineLog.Mobile.Core.Models.WatchList;assembly=CineLog.Mobile.Core"
    ShowMenuButton="True"
    Title="Lists">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="16">

        <!-- Lists overview -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10"
            IsVisible="{Binding ShowWatchLists}">

            <Border Style="{StaticResource InputFieldBorder}" HeightRequest="48">
                <Entry
                    Margin="16,0"
                    Placeholder="New list name"
                    ReturnCommand="{Binding CreateWatchListCommand}"
                    Style="{StaticResource CleanEntry}"
                    Text="{Binding NewWatchListName}" />
            </Border>

            <Button
                Grid.Column="1"
                Command="{Binding CreateWatchListCommand}"
                FontFamily="FASolid"
                Text="{x:Static helpers:FontAwesomeIcons.Plus}"
                Style="{StaticResource PrimaryButton}"
                WidthRequest="48"
                Padding="0" />
        </Grid>

        <Grid Grid.Row="1">

            <CollectionView
                ItemsSource="{Binding Lists}"
                IsVisible="{Binding ShowWatchLists}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="12">
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource PrimaryIconLabel}"
                            FontSize="40"
                            Text="{x:Static helpers:FontAwesomeIcons.List}" />
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource CaptionLabel}"
                            Text="No lists yet." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="watchlist:WatchListCollectionItem">
                        <Border
                            Padding="16"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenWatchListCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="44,*,44,24" ColumnSpacing="12">
                                <Border
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22" />
                                    </Border.StrokeShape>

                                    <Label
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Style="{StaticResource PrimaryIconLabel}"
                                        Text="{x:Static helpers:FontAwesomeIcons.List}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label
                                        Style="{StaticResource BodyLargeLabel}"
                                        FontAttributes="Bold"
                                        Text="{Binding Name}" />
                                    <Label
                                        Style="{StaticResource CaptionLabel}"
                                        Text="{Binding ItemCount, StringFormat='{0} films'}" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteWatchListCommand}"
                                    CommandParameter="{Binding .}"
                                    FontFamily="FASolid"
                                    IsEnabled="{Binding CanDelete}"
                                    Text="{x:Static helpers:FontAwesomeIcons.Trash}"
                                    TextColor="{StaticResource Error}"
                                    WidthRequest="44"
                                    Padding="0">
                                    <Button.Triggers>
                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding CanDelete}"
                                            Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <Label
                                    Grid.Column="3"
                                    VerticalOptions="Center"
                                    Style="{StaticResource SecondaryIconLabel}"
                                    Text="{x:Static helpers:FontAwesomeIcons.ChevronRight}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Expanded list view -->
            <Grid
                IsVisible="{Binding ShowMovies}"
                RowDefinitions="Auto,*"
                RowSpacing="14">

                <Grid Grid.Row="0" ColumnDefinitions="44,*,44" ColumnSpacing="10">
                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding BackToListsCommand}"
                        FontFamily="FASolid"
                        Text="{x:Static helpers:FontAwesomeIcons.ChevronLeft}"
                        TextColor="{StaticResource OnSurface}"
                        WidthRequest="44"
                        Padding="0" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="{Binding SelectedWatchList.Name}" />
                        <Label
                            Style="{StaticResource CaptionLabel}"
                            Text="{Binding SelectedWatchList.ItemCount, StringFormat='{0} films'}" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        Command="{Binding DeleteWatchListCommand}"
                        CommandParameter="{Binding SelectedWatchList}"
                        FontFamily="FASolid"
                        IsEnabled="{Binding SelectedWatchList.CanDelete}"
                        Text="{x:Static helpers:FontAwesomeIcons.Trash}"
                        TextColor="{StaticResource Error}"
                        WidthRequest="44"
                        Padding="0">
                        <Button.Triggers>
                            <DataTrigger
                                TargetType="Button"
                                Binding="{Binding SelectedWatchList.CanDelete}"
                                Value="False">
                                <Setter Property="TextColor" Value="{StaticResource TextDisabled}" />
                                <Setter Property="Opacity" Value="0.35" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <CollectionView
                    Grid.Row="1"
                    ItemsSource="{Binding Movies}"
                    RemainingItemsThreshold="4"
                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="12">
                            <Label
                                HorizontalOptions="Center"
                                Style="{StaticResource PrimaryIconLabel}"
                                FontSize="40"
                                Text="{x:Static helpers:FontAwesomeIcons.Film}" />
                            <Label
                                HorizontalOptions="Center"
                                Style="{StaticResource CaptionLabel}"
                                Text="No movies in this list." />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MovieItem">
                            <Border
                                Padding="12"
                                BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="72,*,44" ColumnSpacing="12">
                                    <Border
                                        WidthRequest="72"
                                        HeightRequest="104"
                                        BackgroundColor="{StaticResource SurfaceVariant}"
                                        StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>

                                        <Image
                                            Source="{Binding PosterPath}"
                                            Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                        <Label
                                            Style="{StaticResource BodyLargeLabel}"
                                            FontAttributes="Bold"
                                            Text="{Binding Title}" />
                                        <Label
                                            Style="{StaticResource PosterRatingLabel}"
                                            Text="{Binding RatingText, StringFormat='★ {0}'}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveMovieCommand}"
                                        CommandParameter="{Binding .}"
                                        FontFamily="FASolid"
                                        Text="{x:Static helpers:FontAwesomeIcons.Trash}"
                                        TextColor="{StaticResource TextSecondary}"
                                        WidthRequest="44"
                                        Padding="0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <ActivityIndicator
                            IsRunning="{Binding IsLoadingMore}"
                            IsVisible="{Binding IsLoadingMore}"
                            Margin="0,12" />
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</pages:BasePage>
