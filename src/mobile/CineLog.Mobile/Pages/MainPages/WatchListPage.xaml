<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    x:Class="CineLog.Mobile.Pages.MainPages.WatchListsPage"
    ShowMenuButton="True"
    Title="WatchLists"
    BackgroundColor="{StaticResource Background}">

    <Grid Padding="24" RowDefinitions="*">

        <Grid IsVisible="{Binding ShowWatchLists}">

            <RefreshView Command="{Binding LoadCommand}">
                <CollectionView
                    ItemsSource="{Binding Lists}"
                    SelectionMode="None"
                    Margin="0,8,0,88">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <AbsoluteLayout
                                HeightRequest="112"
                                Margin="0,0,0,12">

                                <Border
                                    AbsoluteLayout.LayoutBounds="0,0,1,96"
                                    AbsoluteLayout.LayoutFlags="WidthProportional"
                                    Padding="16"
                                    BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="64,*,56" ColumnSpacing="12">

                                        <Border
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            BackgroundColor="{StaticResource SurfaceVariant}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="26" />
                                            </Border.StrokeShape>

                                            <Label
                                                Text="{Binding IconText}"
                                                TextColor="{StaticResource Primary}"
                                                FontSize="22"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsFavorites}"
                                                        Value="True">
                                                        <Setter Property="FontFamily" Value="FASolid" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">

                                            <Label
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource OnSurface}"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="1" />

                                            <Label
                                                Text="{Binding CountText}"
                                                TextColor="{StaticResource TextSecondary}"
                                                FontSize="15" />
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="2"
                                            Text="⋯"
                                            FontSize="24"
                                            Padding="0"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextSecondary}"
                                            IsEnabled="{Binding CanEdit}"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleWatchListOptionsCommand}"
                                            CommandParameter="{Binding .}" />

                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenWatchListCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </Border>

                                <Border
                                    IsVisible="{Binding IsOptionsOpen}"
                                    AbsoluteLayout.LayoutBounds="0.76,20,128,76"
                                    AbsoluteLayout.LayoutFlags="XProportional"
                                    Padding="12,8"
                                    BackgroundColor="{StaticResource Overlay}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    ZIndex="20">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="8">
                                        <Label
                                            Text="Edit"
                                            FontSize="15"
                                            TextColor="{StaticResource OnSurface}"
                                            LineBreakMode="NoWrap"
                                            FontAutoScalingEnabled="False">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartEditWatchListCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>

                                        <Label
                                            Text="Delete"
                                            FontSize="15"
                                            TextColor="{StaticResource Error}"
                                            LineBreakMode="NoWrap"
                                            FontAutoScalingEnabled="False">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteWatchListCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </AbsoluteLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Button
                Text="+"
                FontSize="28"
                FontAttributes="Bold"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,0,16"
                BackgroundColor="{StaticResource Primary}"
                TextColor="{StaticResource OnPrimary}"
                Command="{Binding ShowCreateWatchListCommand}" />

            <Grid
                IsVisible="{Binding IsCreatingWatchList}"
                ZIndex="30">

                <BoxView Color="#99000000">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCreateWatchListCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <Border
                    Padding="20"
                    WidthRequest="320"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <Label
                            Text="New watchlist"
                            TextColor="{StaticResource OnSurface}"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                            <Entry
                                Text="{Binding NewWatchListName}"
                                Placeholder="List name"
                                PlaceholderColor="{StaticResource TextSecondary}"
                                TextColor="{StaticResource OnSurface}"
                                ReturnCommand="{Binding ConfirmCreateWatchListCommand}"
                                BackgroundColor="Transparent" />

                            <Button
                                Grid.Column="1"
                                Text="✓"
                                FontSize="18"
                                Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Command="{Binding ConfirmCreateWatchListCommand}" />
                        </Grid>

                        <Button
                            Text="Cancel"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextSecondary}"
                            Command="{Binding CancelCreateWatchListCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding ShowMovies}" RowDefinitions="Auto,*">

            <Grid ColumnDefinitions="44,*" Padding="0,4,0,16">
                <Button
                    Text="‹"
                    FontSize="28"
                    Padding="0"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource OnBackground}"
                    Command="{Binding BackToListsCommand}" />

                <Label
                    Grid.Column="1"
                    Text="{Binding SelectedWatchList.Name}"
                    TextColor="{StaticResource OnBackground}"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Movies}"
                RemainingItemsThreshold="3"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Border}"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="64,*,44" ColumnSpacing="12">

                                <Border
                                    WidthRequest="56"
                                    HeightRequest="76"
                                    BackgroundColor="{StaticResource SurfaceVariant}"
                                    StrokeThickness="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>

                                    <Image
                                        Source="{Binding PosterPath}"
                                        Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Title}"
                                        TextColor="{StaticResource OnSurface}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding RatingText}"
                                        TextColor="{StaticResource Primary}"
                                        FontSize="13" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="2"
                                    Text="✕"
                                    Padding="0"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Error}"
                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveMovieCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <ActivityIndicator
                        IsRunning="{Binding IsLoadingMore}"
                        IsVisible="{Binding IsLoadingMore}"
                        Color="{StaticResource Primary}"
                        Margin="0,12" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</pages:BasePage>
