<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.MainPages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:review="clr-namespace:CineLog.Mobile.Core.Models.Review;assembly=CineLog.Mobile.Core"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Home;assembly=CineLog.Mobile.Core"
    Title="Movies"
    x:DataType="vm:HomeViewModel"
    ShowMenuButton="True">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="18">

            <Label
                IsVisible="{Binding HasError}"
                Style="{StaticResource CaptionLabel}"
                Text="{Binding ErrorMessage}" />

            <controls:MovieCarousel
                Title="Top Rated"
                IsLoading="{Binding IsBusy}"
                IsLoadingMore="{Binding IsLoadingMoreTopRated}"
                ItemTappedCommand="{Binding GoToMovieCommand}"
                ItemsSource="{Binding TopRatedMovies}"
                LoadMoreCommand="{Binding LoadMoreTopRatedCommand}"
                SeeAllCommand="{Binding GoToTopRatedCommand}" />

            <BoxView Style="{StaticResource ListDivider}" />

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Style="{StaticResource SectionHeaderLabel}"
                    Text="Latest Reviews"
                    VerticalOptions="Center" />

                <Button
                    Grid.Column="1"
                    Padding="8,0"
                    BackgroundColor="Transparent"
                    Command="{Binding GoToAllReviewsCommand}"
                    FontAttributes="Bold"
                    Text="See all"
                    TextColor="{StaticResource Primary}" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LatestReviews}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="review:ReviewListItem">
                        <controls:ReviewListCard
                            GoToMovieCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=GoToMovieFromReviewCommand}"
                            IsLatestMode="True"
                            LikeCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=ToggleLatestReviewLikeCommand}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</pages:BasePage>
