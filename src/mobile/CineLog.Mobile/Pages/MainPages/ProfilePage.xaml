<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CineLog.Mobile.Pages.MainPages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CineLog.Mobile.Controls"
    xmlns:helpers="clr-namespace:CineLog.Mobile.Helpers"
    xmlns:models="clr-namespace:CineLog.Mobile.Core.Models;assembly=CineLog.Mobile.Core"
    xmlns:pages="clr-namespace:CineLog.Mobile.Pages"
    xmlns:review="clr-namespace:CineLog.Mobile.Core.Models.Review;assembly=CineLog.Mobile.Core"
    xmlns:vm="clr-namespace:CineLog.Mobile.Core.ViewModels.Profile;assembly=CineLog.Mobile.Core"
    Title="Profile"
    x:DataType="vm:ProfileViewModel"
    NavBarRightCommand="{Binding LogoutCommand}"
    NavBarRightIcon="{x:Static helpers:FontAwesomeIcons.SignOut}"
    ShowMenuButton="True">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <controls:ProfileHeaderSkeleton IsVisible="{Binding IsBusy}" />

            <Grid
                ColumnDefinitions="Auto, *, Auto"
                ColumnSpacing="15"
                IsVisible="{Binding IsNotBusy}">
                <Border
                    HeightRequest="80"
                    StrokeThickness="0"
                    WidthRequest="80">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40" />
                    </Border.StrokeShape>
                    <Image Source="{Binding AvatarUrl}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Style="{StaticResource HeadlineMediumLabel}" Text="{Binding Username}" />

                    <Label
                        Margin="0,5,0,0"
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        Style="{StaticResource BodyMediumLabel}"
                        Text="{Binding Bio}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsBioExpanded}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="MaxLines" Value="4" />
                                <Setter Property="LineBreakMode" Value="WordWrap" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label
                        Margin="0,2,0,0"
                        IsVisible="{Binding ShowExpandButton}"
                        Style="{StaticResource CaptionLabel}"
                        Text="Show full">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleBioCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Margin="0,2,0,0"
                        IsVisible="{Binding ShowCollapseButton}"
                        Style="{StaticResource CaptionLabel}"
                        Text="Show less">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleBioCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <Label
                    Grid.Column="2"
                    FontFamily="FASolid"
                    FontSize="18"
                    HeightRequest="44"
                    HorizontalTextAlignment="Center"
                    Text="{x:Static helpers:FontAwesomeIcons.Edit}"
                    TextColor="{StaticResource TextSecondary}"
                    VerticalOptions="Start"
                    VerticalTextAlignment="Center"
                    WidthRequest="44">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenEditProfileCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <controls:ProfileStatsSkeleton IsVisible="{Binding IsBusy}" />

            <Border
                Padding="15"
                BackgroundColor="{StaticResource Surface}"
                IsVisible="{Binding IsNotBusy}"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, *, *, *">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="{Binding FilmsCount}" />
                        <Label Style="{StaticResource OverlineLabel}" Text="FILMS" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="67" />
                        <Label Style="{StaticResource OverlineLabel}" Text="THIS YEAR" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="{Binding FollowersCount}" />
                        <Label Style="{StaticResource OverlineLabel}" Text="FOLLOWERS" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource HeadlineMediumLabel}"
                            Text="{Binding FollowingCount}" />
                        <Label Style="{StaticResource OverlineLabel}" Text="FOLLOWING" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Style="{StaticResource SectionHeaderLabel}" Text="FAVORITE FILMS" />

                <controls:FavouriteFilmsSkeleton IsVisible="{Binding IsBusy}" />

                <CollectionView IsVisible="{Binding IsNotBusy}" ItemsSource="{Binding FavouriteMovies}">
                    <CollectionView.EmptyView>
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource CaptionLabel}"
                            Text="No favorite films yet."
                            VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MovieItem">
                            <Grid>
                                <controls:MoviePosterCard
                                    Title="{Binding Title}"
                                    PosterPath="{Binding PosterPath}"
                                    RatingText="{Binding RatingText}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=GoToMovieCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Style="{StaticResource SectionHeaderLabel}" Text="RECENT DIARY" />
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource AccentLabel}"
                        Text="View all">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAllReviewsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <controls:DiaryListSkeleton IsVisible="{Binding IsBusy}" />

                <CollectionView IsVisible="{Binding IsNotBusy}" ItemsSource="{Binding Reviews}">
                    <CollectionView.EmptyView>
                        <Label
                            HorizontalOptions="Center"
                            Style="{StaticResource CaptionLabel}"
                            Text="No recent diary entries."
                            VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="review:ReviewListItem">
                            <controls:ReviewListCard IsMovieMode="False" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</pages:BasePage>
